# CivicShield Frontend Environment Configuration

# Base URL for the CivicShield backend API:
# - Local Development: Leave this unset (or commented out). The app defaults to http://localhost:8000/api.
# - Deployed / Production: Set to your deployed backend's public URL (e.g., https://civicshield-backend.onrender.com).
#   If a scheme (https://) or trailing /api is omitted, the frontend automatically normalizes it.
VITE_API_BASE_URL=https://civicshield-backend.onrender.com
